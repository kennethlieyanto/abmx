# Copy to .env (gitignored) and fill in. `direnv` loads it on entry.
#
# These take precedence over the same fields in abmx.toml, so you can keep
# the config file free of secrets. See README "Secrets".

# ---------------------------------------------------------------------------
# abmx itself
# ---------------------------------------------------------------------------

# Gmail OAuth client secret (Google Cloud → Credentials → Desktop app).
ABMX_GMAIL_CLIENT_SECRET=

# Actual's budget-scoped API key. Create one in the budget:
# Settings → General → Security → API keys (only if your Actual build offers it).
# This is Actual's own key, not a wrapper's.
ABMX_ACTUAL_API_KEY=

# Fallback for Actual servers too old to have API keys. Prefer the API key.
ABMX_ACTUAL_SERVER_PASSWORD=

# Only for end-to-end encrypted Actual budgets.
ABMX_ACTUAL_BUDGET_PASSWORD=

# Optional: point at a config file instead of the XDG/./abmx.toml discovery.
# ABMX_CONFIG=./abmx.toml

# Optional overrides, mostly for services and containers:
# ABMX_ACTUAL_SERVER_URL=http://localhost:5006
# ABMX_ACTUAL_DATA_DIR=~/.cache/abmx/actual
# ABMX_ACTUAL_HELPER=/usr/share/abmx/actual-helper/helper.js
# ABMX_NODE=node
