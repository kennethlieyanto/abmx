# Copy to .env (gitignored) and fill in. `direnv` loads it on entry, and
# `just actual-api` / docker compose read it too.
#
# These take precedence over the same fields in txsync.toml, so you can keep
# the config file free of secrets. See README "Secrets".

# ---------------------------------------------------------------------------
# txsync itself
# ---------------------------------------------------------------------------

# Gmail OAuth client secret (Google Cloud → Credentials → Desktop app).
TXSYNC_GMAIL_CLIENT_SECRET=

# actual-http-api's own API key (not your Actual server password).
# Generate one with: openssl rand -hex 24
TXSYNC_ACTUAL_API_KEY=

# Only for end-to-end encrypted Actual budgets.
TXSYNC_ACTUAL_BUDGET_PASSWORD=

# Optional: point at a config file instead of the XDG/./txsync.toml discovery.
# TXSYNC_CONFIG=./txsync.toml

# ---------------------------------------------------------------------------
# docker compose (just actual-api)
# ---------------------------------------------------------------------------

# Where the wrapper reaches your Actual server from inside the container.
#   Actual on this host:        http://host.docker.internal:5006
#   Actual on another machine:  http://192.168.1.10:5006
#   Actual in this compose:     http://actual-server:5006
ACTUAL_SERVER_URL=http://host.docker.internal:5006

# Your Actual *server* password (not the wrapper's API key).
ACTUAL_SERVER_PASSWORD=

# Host port for the wrapper.
ACTUAL_HTTP_API_PORT=5007

# Must match your Actual server's version.
ACTUAL_HTTP_API_TAG=26.10.0
